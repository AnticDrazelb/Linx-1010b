# Kernel config fragment for the Linx 1010B (Bay Trail-T, Atom Z3735F).
#
# Applied on top of Debian's kernel config with scripts/kconfig/merge_config.sh,
# so this only states what DIFFERS - everything not mentioned keeps the Debian
# default. That is deliberate: a hand-written full .config rots the moment the
# kernel version moves, whereas a fragment keeps working.
#
# Goal: remove drivers and subsystems this machine physically cannot use, which
# shrinks the kernel image, shortens module probing at boot, and reduces the
# resident kernel footprint on a 2 GB machine.

# --- Platform ----------------------------------------------------------------
CONFIG_64BIT=y
CONFIG_MATOM=y
# EFI mixed mode: lets a 64-bit kernel be started from 32-bit EFI firmware.
# GRUB's i386-efi build already handles the handoff, but enabling this keeps the
# EFI stub usable and makes efivars work correctly on this firmware.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_MIXED=y
CONFIG_X86_INTEL_LPSS=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_INTEL_IDLE=y

# Single-socket, 4-core SoC. No NUMA, no hotplug of physical CPUs.
# CONFIG_NUMA is not set
CONFIG_NR_CPUS=4

# --- Preemption / timers -----------------------------------------------------
# Full preemption noticeably improves desktop responsiveness on a slow in-order
# Atom, at a small throughput cost that does not matter for this workload.
CONFIG_PREEMPT=y
# Tickless idle saves real power on a battery device.
CONFIG_NO_HZ_IDLE=y
CONFIG_HZ_250=y
CONFIG_HZ=250

# --- Graphics ----------------------------------------------------------------
CONFIG_DRM_I915=y
CONFIG_DRM_I915_FORCE_PROBE=""
CONFIG_DRM_FBDEV_EMULATION=y
# No other GPU exists on this board.
# CONFIG_DRM_AMDGPU is not set
# CONFIG_DRM_RADEON is not set
# CONFIG_DRM_NOUVEAU is not set
# CONFIG_DRM_I2C_NXP_TDA998X is not set

# --- Storage -----------------------------------------------------------------
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_ACPI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
# No SATA, no SCSI disks, no RAID on this device. USB storage stays modular
# because install media needs it.
# CONFIG_ATA is not set
# CONFIG_MD is not set
# CONFIG_BLK_DEV_DRBD is not set

# --- Input -------------------------------------------------------------------
# Goodix touchscreen: enumerated over ACPI as GDIX1001 on I2C. Built in so touch
# works in the installer and in early boot without a module load.
CONFIG_I2C=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_GOODIX=y
CONFIG_TOUCHSCREEN_DMI=y
CONFIG_HID_MULTITOUCH=y

# --- Backlight ---------------------------------------------------------------
# Bay Trail drives the panel backlight through the LPSS PWM block. Built in
# rather than modular so there is no initramfs ordering problem at all.
CONFIG_PWM=y
CONFIG_PWM_LPSS=y
CONFIG_PWM_LPSS_PLATFORM=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# --- Audio -------------------------------------------------------------------
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SST_ATOM_HIFI2_PLATFORM_ACPI=y
CONFIG_SND_SOC_INTEL_BYTCR_RT5640_MACH=y
CONFIG_SND_SOC_INTEL_BYTCR_RT5651_MACH=y
CONFIG_SND_SOC_INTEL_BYT_CHT_ES8316_MACH=y
CONFIG_SND_HDA_INTEL=m

# --- Power / sensors ---------------------------------------------------------
CONFIG_MFD_AXP20X_I2C=y
CONFIG_AXP288_CHARGER=y
CONFIG_AXP288_FUEL_GAUGE=y
CONFIG_INTEL_SOC_DTS_THERMAL=y
CONFIG_IIO=y
CONFIG_KXCJK1013=m
CONFIG_BMC150_ACCEL=m

# --- Networking --------------------------------------------------------------
CONFIG_RTL8723BS=m
CONFIG_BT=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_3WIRE=y
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_RTL=m
CONFIG_TCP_CONG_BBR=m
CONFIG_NET_SCH_FQ_CODEL=y
# No wired NIC on the tablet or the dock.
# CONFIG_ETHERNET is not set

# --- Compression -------------------------------------------------------------
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_LZ4="y"
CONFIG_CRYPTO_LZ4=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XZ=y

# --- Strip debug and unused subsystems --------------------------------------
# Debug info dominates the size of a Debian kernel build. Turning it off cuts
# build time roughly in half and the package size by an order of magnitude.
# CONFIG_DEBUG_INFO is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_KGDB is not set
# CONFIG_FTRACE is not set
# CONFIG_KPROBES is not set

# Virtualisation host support is dead weight on an Atom tablet.
# CONFIG_KVM is not set
# CONFIG_XEN is not set
# CONFIG_VIRTIO_PCI is not set

# Legacy buses and ports this device does not have.
# CONFIG_ISA is not set
# CONFIG_PARPORT is not set
# CONFIG_PCCARD is not set
# CONFIG_FIREWIRE is not set
# CONFIG_RAPIDIO is not set

# Exotic filesystems.
# CONFIG_REISERFS_FS is not set
# CONFIG_JFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_OCFS2_FS is not set
# CONFIG_NILFS2_FS is not set
# CONFIG_HFS_FS is not set
# CONFIG_HFSPLUS_FS is not set
