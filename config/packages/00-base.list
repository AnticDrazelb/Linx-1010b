# Minimal bootable Debian base. debootstrap runs with --variant=minbase, so
# everything the system needs is listed explicitly here or in a later list.
# APT::Install-Recommends is off (see overlay/etc/apt/apt.conf.d/99-linx), so
# nothing arrives that is not named.

systemd-sysv
systemd-timesyncd
systemd-resolved
dbus-broker
init
udev
kmod
libpam-systemd
locales
tzdata
ca-certificates
sudo
less
nano
bash-completion
file
psmisc

# initramfs-tools compresses the initramfs with zstd by default on Debian 13,
# and silently falls back to gzip if the binary is absent. zstd decompresses
# faster than gzip and produces a smaller image - both of which matter on a
# 1.33 GHz Atom reading from a slow eMMC at every boot.
zstd
procps
iproute2
iputils-ping
curl
gpg
apt-utils
console-setup
keyboard-configuration
